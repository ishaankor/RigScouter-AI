{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rigscouter-ai",
	"main": ".vercel/output/static/_worker.js/index.js",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"rules": [
		{
			"type": "ESModule",
			"globs": [
				"**/*.js"
			],
			"fallthrough": true
		}
	],
	"assets": {
		"directory": ".vercel/output/static",
		"binding": "ASSETS"
	},
	"vars": {
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_NSsV5EqbGpcCVav71oRN8Q_lDnXq7sy",
		"NEXT_PUBLIC_BACKEND_URL": "https://rigscouter-ai-database.onrender.com",
		"BACKEND_URL": "https://rigscouter-ai-database.onrender.com"
	},
	"routes": [
		{
			"pattern": "rigscouter.ishaankoradia.com",
			"zone_name": "ishaankoradia.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	]
}