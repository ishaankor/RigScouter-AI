{
  "name": "rigscouter-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "pages:build": "prisma generate && npx @cloudflare/next-on-pages && node -e \"const fs=require('fs');let c=fs.readFileSync('.vercel/output/static/_worker.js/index.js','utf8');c=c.replace(/import\\(e\\.entrypoint\\)/g,'import(e.entrypoint.startsWith(\\\"./\\\")?e.entrypoint:\\\"./\\\"+e.entrypoint)');fs.writeFileSync('.vercel/output/static/_worker.js/index.js',c);\" && touch .vercel/output/static/.assetsignore",
    "deploy": "npm run pages:build && npx wrangler deploy",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.1",
    "@tavily/core": "^0.7.7",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.5.0",
    "lucide-react": "^0.417.0",
    "next": "^15.1.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.40",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "wrangler": "^4.119.0"
  }
}
