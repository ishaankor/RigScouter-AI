{
  "name": "rigscouter-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "pages:build": "prisma generate && npx @cloudflare/next-on-pages && touch .vercel/output/static/.assetsignore",
    "deploy": "npm run pages:build && npx wrangler pages deploy .vercel/output/static",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.1",
    "@tavily/core": "^0.7.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "next": "^15.1.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.40",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "wrangler": "^4.119.0"
  }
}
